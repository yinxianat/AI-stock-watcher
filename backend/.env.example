# ===== Little Money Monkey: backend env =====
# Copy this file to `.env` and fill in real values for local dev.
# NEVER commit `.env` to git.

# --- App ---
APP_ENV=development                  # development | uat | production | test
APP_DEBUG=true
# Interactive docs (/docs, /redoc, /openapi.json). Unset = served only on a
# developer machine; any deployed environment (uat, production) hides them,
# because a complete API map is free reconnaissance. Set true in UAT if
# testers need them. Leave unset in production.
# API_DOCS_PUBLIC=true
SECRET_KEY=change-me-to-a-long-random-string
FRONTEND_BASE_URL=http://localhost:5173

# --- Database ---
# Local dev defaults to a SQLite file. In production set DATABASE_URL to
# the Postgres connection string Railway provides (e.g. postgresql+psycopg://...).
DATABASE_URL=sqlite:///./dev.db

# --- Auth (magic link) ---
MAGIC_LINK_TTL_MINUTES=15
EMAIL_CONFIRM_TTL_MINUTES=60

# --- Email send limits ---
# Protects inboxes from repeated "Send link" / "Send confirmation" clicks.
# Per address (sign-in) or per user (confirmation): wait this many seconds
# between emails, and send at most EMAIL_BURST_LIMIT within
# EMAIL_BURST_WINDOW_MINUTES. Defaults keep the longest wait under 10 min.
EMAIL_RESEND_COOLDOWN_SECONDS=30
EMAIL_BURST_LIMIT=5
EMAIL_BURST_WINDOW_MINUTES=10

# --- Alerts ---
# Rule added automatically when a stock is added to a watchlist: email if it
# moves below -N% or above +N% vs. the previous close. 0 disables it.
DEFAULT_RULE_BAND_PCT=1.5
# How long the "Stop all alert emails" link in alert emails stays valid.
UNSUBSCRIBE_LINK_TTL_DAYS=365

# --- Daily watchlist recap ---
# One email per user every trading day after the close: every watched
# stock's move (biggest first), new highs/lows, and a kids' story about the
# biggest mover (AI story if it passes the story bar and AI_ARTICLES_ENABLED,
# else the fixed small-move note). Users can turn it off in Settings.
RECAP_ENABLED=true
# US/Eastern, Mon-Fri. Keep it after the last batch time (16:05), which
# saves today's closes; market holidays are skipped automatically.
RECAP_TIME_ET=16:30
# Seconds the recap waits for new AI stories; late ones follow as a reply.
RECAP_STORY_WAIT_SECONDS=300

# --- AI "why it moved" stories ---
# When a day-over-day price alert fires, an AI-written story (for parents to
# read with their kids) explains the move. Off by default.
AI_ARTICLES_ENABLED=false

# Main AI and backup AI: "anthropic" or "gemini". The backup writes the story
# when the main one is down, out of quota or its key is rejected, and the
# admin (ALERT_RECEIVER) is emailed. Leave AI_FALLBACK_PROVIDER blank for none.
#   anthropic — Claude. ~$0.025 per story on Haiku with 2 web searches.
#               Key: console.anthropic.com
#   gemini    — Google. Free tier available, but Gemini's API terms bar
#               services likely to be used by under-18s, and its Google
#               Search results can't be rewritten — check before using.
#               Key: aistudio.google.com/apikey
AI_PROVIDER=anthropic
AI_FALLBACK_PROVIDER=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Models, comma-separated, one per provider. A provider not listed uses its
# cheapest (Claude: claude-haiku-5-5, Gemini: gemini-3.1-flash-lite).
AI_ARTICLE_MODEL=claude-haiku-5-5
# true while your Gemini project has no billing account (free tier), so cost
# estimates show $0 for Gemini. Set false if you enable Google billing.
AI_GEMINI_FREE_TIER=true

# Where news comes from:
#   web_search — Claude's web search on AI_NEWS_DOMAINS, $0.01 per search
#                (Claude only)
#   finnhub    — free, uses FINNHUB_API_KEY (either provider), but Finnhub's
#                free plan is licensed for personal use
AI_NEWS_SOURCE=web_search
# With web_search: the only sites searched, and the only links in emails.
AI_NEWS_DOMAINS=finance.yahoo.com,cnbc.com,cnn.com,axios.com,npr.org,techcrunch.com
# Web searches per story with web_search, $0.01 each.
AI_ARTICLE_MAX_SEARCHES=2
# How many times the WRITER may be asked for one story. 1 = one shot: a
# story our language check or the AI reviewer rejects simply isn't sent.
# 2 lets the writer try again, told what was wrong last time; research is
# reused, so a retry costs about $0.001 against ~$0.026 for the story.
#
# The reviewer is NOT retried and stays single on purpose. A second
# reviewer exists to overturn a rejection, and a story one reviewer judged
# unsuitable for a child isn't something to send because another model
# disagreed. The gate never moves — only the number of chances to clear it.
# Keep this low: each retry is told what the reviewer objected to, which is
# what makes it work and also makes it a writer being coached past its own
# safety check.
AI_ARTICLE_MAX_WRITE_ATTEMPTS=2
# With finnhub: publishers whose articles count.
AI_FINNHUB_SOURCES=Yahoo,CNBC
# News older than this many days doesn't count as today's reason.
AI_NEWS_MAX_AGE_DAYS=2

# Seconds an alert waits for its story. If it's not ready, the alert says
# "still looking" and the story follows as a reply when done.
AI_ARTICLE_WAIT_SECONDS=120
# Give up on a promised follow-up after this many minutes.
AI_ARTICLE_FOLLOWUP_GIVE_UP_MINUTES=20
# Stories generated at the same time (use 2 on Gemini's free tier: each
# story makes 3 requests).
AI_ARTICLE_MAX_CONCURRENT=4
# After a key or quota problem, skip that provider for this many minutes.
AI_KEY_PROBLEM_PAUSE_MINUTES=30
# Smallest day-over-day move (up or down, in %) that gets an AI story.
# Smaller moves get a short fixed "small move" note instead (no AI cost).
# Funds = ETFs and indexes, which usually move less than single stocks.
AI_ARTICLE_MIN_PCT_STOCK=1
AI_ARTICLE_MIN_PCT_FUND=0.5
# New stories per trading day (biggest moves first).
AI_ARTICLE_MAX_PER_DAY=30
# Moves of at least this % (up or down) still get a story after the daily
# cap is reached, up to twice the cap.
AI_ARTICLE_ALWAYS_PCT=5
# Whole-market benchmark for "most stocks fell today".
AI_MARKET_SYMBOL=SPY

# --- SMTP / Email ---
# For local dev, point this at Mailtrap, MailHog, or any other SMTP catcher.
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Little Money Monkey <you@example.com>
SMTP_USE_TLS=true
# Socket timeout in seconds for each SMTP operation (not the whole
# conversation). Below ~20s Gmail intermittently fails to acknowledge the
# DATA of an HTML story email in time and the send dies after the message
# was already handed over, which looks like a failure but may have been
# delivered.
SMTP_TIMEOUT=30

# --- Batch jobs ---
# Comma-separated cron-like HH:MM times in US/Eastern.
BATCH_JOB_TIMES_ET=09:35,12:30,16:05
# Retention sweep: deletes log_entries past LOG_LIFETIME and daily_closes
# past PRICE_HISTORY_LIFETIME. Off-peak so a long delete never overlaps a
# pipeline run.
LOG_CLEANUP_TIME_ET=03:15
# Minute past each weekday hour that the pipeline heartbeat checks in, and
# alerts once if a pipeline was due and never started. Not :00 on purpose —
# that is when every other cron on the box fires.
HEARTBEAT_MINUTE=20
# Self-ping that stops Railway sleeping the container. If this is longer
# than Railway's idle window the in-process scheduler dies between runs,
# and no batch job fires until someone visits the site.
KEEPALIVE_INTERVAL_SECONDS=300
#
# All of the above, plus RECAP_TIME_ET and DAILY_SUMMARY_TIME_ET, are read
# by app/jobs/scheduler.py at startup and reported by GET /admin/schedule.
# A change here takes effect on the next deploy, not immediately — that
# endpoint compares each configured time against the running scheduler and
# says so when a redeploy is pending.
BATCH_JOBS_ENABLED=true

# --- CORS ---
CORS_ORIGINS=http://localhost:5173

# --- Logging & alerting ---
# Recipient for admin alerts (errors, signups, daily summary).
# Defaults to SMTP_USERNAME if blank.
ALERT_RECEIVER=
# Toggle alerts entirely (set false in CI / when SMTP is offline).
ALERTS_ENABLED=true
# Persist WARNING+ logs to the `log_entries` DB table.
LOG_DB_PERSISTENCE=true
# How long log rows are kept. Units: s/m/h/d/w/M/y (lowercase m = minutes,
# uppercase M = month ≈ 30 days). Bare integer = days. Examples: 24h, 7d,
# 30d, 1M, 90d, 1y.
LOG_LIFETIME=30d
# Daily summary email (HH:MM in US/Eastern). Default 17:30 — after the
# 16:05 batch completes.
DAILY_SUMMARY_TIME_ET=17:30
DAILY_SUMMARY_ENABLED=true

# --- Price history retention ---
# How long to keep DailyClose rows (the durable per-day closing-price
# history used to compute previous-day change and week/month/quarter/year
# extremes). Pruned daily by the cleanup job. Same units as LOG_LIFETIME.
#
# Keep this in YEARS, not days. These rows are the training features for
# the planned story-generation model, and stock_articles (the labels) is
# never pruned — so a short window silently destroys training examples:
# the story survives, but what the price actually did is gone, and that
# is irreversible. /admin/ml-corpus reports the damage as ml_data_loss.
# Rows are ~90 bytes, so a decade of 50 tickers costs a few MB.
PRICE_HISTORY_LIFETIME=3650d

# --- Intraday capture ---
# Capture latest price for every watched ticker on a fast cadence during
# US market hours. PRICE_CHANGE_RANGE rules fire on the day-over-day %
# (vs the previous trading day's close).
INTRADAY_INGEST_ENABLED=true
INTRADAY_TICK_MINUTES=30
# Retention for IntradayPrice rows (same units as LOG_LIFETIME). 7 days of
# 30-min ticks for ~50 watched tickers is ~5k rows — trivial.
INTRADAY_RETENTION=7d
# US-Eastern market hours window. Job exits early outside this window.
INTRADAY_MARKET_OPEN_ET=09:30
INTRADAY_MARKET_CLOSE_ET=16:00

# --- Stock-data provider ---
# Picks where price data comes from.
#   "yfinance" (default)  — unofficial Yahoo scraping. Free, no key, but
#                           breaks under Yahoo anti-bot crackdowns. Daily
#                           history also comes from yfinance.
#   "finnhub"              — recommended. Live quotes use Finnhub /quote
#                            (free, 60 req/min) and daily history uses
#                            Twelve Data /time_series (free, 800 req/day).
#                            Finnhub's /stock/candle is paid-only since
#                            2024 — that's why history goes through Twelve
#                            Data here.
#
# To use finnhub:
#   1. Sign up at https://finnhub.io (free) → copy API key to FINNHUB_API_KEY
#   2. Sign up at https://twelvedata.com (free) → copy key to TWELVEDATA_API_KEY
#   3. Set STOCK_DATA_PROVIDER=finnhub
STOCK_DATA_PROVIDER=finnhub
FINNHUB_API_KEY=
TWELVEDATA_API_KEY=
# Client-side rate limits (requests/minute), set below each free tier's
# published ceiling so a burst can't spend the whole allowance and start
# collecting 429s. Finnhub free is 60/min; Twelve Data Basic is 8/min and
# 800/day. Calls are spread across the window instead of fired at once,
# which costs no freshness: alerts compare against the previous trading
# day's close, not a recent tick.
FINNHUB_MAX_PER_MIN=50
TWELVEDATA_MAX_PER_MIN=8
# How stale a stored daily close may be and still count as "the previous
# trading day's close". Past this we ask the provider instead, so the
# percentage in an alert matches what a public quote shows. 4 days covers
# a weekend plus a holiday.
PREV_CLOSE_MAX_AGE_DAYS=4

# After setting these, run a one-shot health check from the backend dir:
#   python -m app.services.stock_data AAPL
# It prints {current_price, previous_close, history_rows, ok} so you can
# confirm the provider wiring before the next scheduled batch.
# Add `--debug` to dump raw upstream responses if something looks off.


# ============================================================
# Admin dashboard + monitoring agent
# ============================================================

# --- Human admin access ---
# Comma-separated login emails that always have admin access to /admin.
# This is the BOOTSTRAP: it works before that person has ever signed in,
# and it means losing DB access can't lock everyone out. Use the address
# you sign in with. Additional admins get a row in `admin_roles` instead
# (one INSERT, no deploy):
#   INSERT INTO admin_roles (user_id, role, granted_at)
#   SELECT id, 'admin', now() FROM users WHERE email = 'them@example.com';
ADMIN_EMAILS=you@example.com,

# --- Monitoring agent credential ---
# The agent's secret. NOT sent on every request: the agent POSTs it once
# per run to /admin/service-login and gets a short-lived token back, so a
# captured header expires in minutes instead of lasting until rotation.
# Blank disables service access entirely (503) — a missing secret must
# never mean "open to everyone". Minimum 32 characters; shorter is refused.
# Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Never paste it into a chat, an issue, or a commit.
ADMIN_API_TOKEN=

# How long an issued service token lasts. Short on purpose: the agent only
# needs it for one run.
SERVICE_TOKEN_TTL_MINUTES=15

# --- Data Lens: the admin's read-only SQL console ---
# Reachable at /admin/data-lens by a signed-in admin only — never with the
# monitoring agent's token, because arbitrary SELECTs can't promise to be
# free of personal data the way the agent's other endpoints can.
#
# Safe by construction rather than by trust: on Postgres every query runs
# inside `SET TRANSACTION READ ONLY` and is rolled back afterwards, so the
# database itself refuses a write even if the validator is wrong.
DATA_LENS_ENABLED=true
# Hard ceiling on rows returned, enforced when the cursor is read — a query
# carrying its own huge LIMIT is still capped here.
DATA_LENS_MAX_ROWS=500
# Postgres statement_timeout for console queries. A careless join should
# fail in seconds, not hold a connection against production.
DATA_LENS_TIMEOUT_MS=5000
# Email addresses are masked in results by default (al***@example.com), so
# a screenshot or a stolen session yields pseudonyms. Row ids are always
# shown, which is enough to correlate against the rest of the dashboard.
# Set true only when you actually need to read an address.
DATA_LENS_SHOW_EMAILS=false
# "Explain this result": an AI reads the rows and says what they mean, what
# looks wrong, and what to query next. It is given the result AFTER masking
# and the catalogue notes for the tables involved — the notes are what make
# the answer useful rather than a restatement of the grid.
#
# It never runs SQL. Its suggested follow-up queries are validated and shown
# to you to click; nothing on that path executes what the AI wrote.
#
# Off by default because unlike the rest of the console this costs money per
# press. It uses AI_PROVIDER and the same keys as the kids' stories, so there
# is one AI to configure and one bill to read.
DATA_LENS_AI_ENABLED=false
# Rows handed to the AI. Well below DATA_LENS_MAX_ROWS because the whole
# result goes into the prompt, so this is the cost dial: ~100 rows is enough
# to show a pattern and cheap enough to press repeatedly.
DATA_LENS_AI_MAX_ROWS=100

# --- Root Cause: the admin's diagnostic agent ---
# At /admin/root-cause. Ask "why is there no AI article in this environment"
# and get an answer plus the fix, from the day's monitoring report, the
# recent logs, the delivery_outcomes reason counts and the source.
#
# It cannot change anything. Any query it asks for runs through Data Lens's
# read-only transaction, and it can only read .py files under backend/app —
# `.env` lives one directory above that tree, deliberately out of reach.
#
# Off by default: it costs money per question.
ROOT_CAUSE_ENABLED=false
# Models the admin may pick from, cheapest first. A list rather than free
# text so a typo cannot silently bill a 20x model, and so the picker can
# show a price beside each name. Measured: a question costs about $0.001 on
# Haiku, $0.02 on Sonnet, $0.04 on Opus.
ROOT_CAUSE_MODELS=claude-haiku-5-5,claude-sonnet-5-5,claude-opus-5-5
# The agent gets one follow-up round. These bound what that round can cost.
ROOT_CAUSE_MAX_FILES=6
ROOT_CAUSE_MAX_FILE_KB=40
# Recent WARNING+ log lines put in front of it.
ROOT_CAUSE_LOG_LINES=120

# --- Rate limiting ---
# Per-IP limits. `false` is a full off switch that needs no deploy.
RATE_LIMIT_ENABLED=true
# Sign-in emails per IP. The per-address throttle in `send_limits` is
# bypassed by rotating the target address, so this is what actually
# protects the SMTP quota and stops the app mailing strangers. A household
# behind one NAT shares this budget — loosen if real users get blocked.
RATE_LIMIT_SIGNIN=5/hour
